  <property name="styleSheet">
   <string notr="true">/* --- Nền chính của ứng dụng --- */
QMainWindow { 
    background-color: #f0f2f5; 
}

/* --- Tiêu đề Header --- */
QLabel#lblHeader {
    color: #1a237e;
    padding: 10px;
    border-bottom: 2px solid #3f51b5;
}

/* --- Các khung GroupBox --- */
QGroupBox {
    font-weight: bold;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    margin-top: 15px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px 0 5px;
    color: #37474f;
}

/* --- Nút bấm Điều phối Khẩn cấp --- */
QPushButton#btnDispatch {
    background-color: #e53935;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    font-size: 13px;
    border: none;
}
QPushButton#btnDispatch:hover {
    background-color: #d32f2f;
}
QPushButton#btnDispatch:pressed {
    background-color: #b71c1c;
}

/* --- Bảng dữ liệu (TableWidget) --- */
QTableWidget {
    gridline-color: #eceff1;
    background-color: #ffffff;
    alternate-background-color: #f9fbe7;
    selection-background-color: #e3f2fd;
    selection-color: #000000;
    border: none;
}
QHeaderView::section {
    background-color: #37474f;
    color: white;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #263238;
}

/* --- Màn hình Terminal Log --- */
QTextEdit#txtConsole {
    background-color: #263238;
    color: #00e676; /* Màu xanh lá cây kiểu terminal */
    font-family: &quot;Consolas&quot;, monospace;
    font-size: 13px;
    border-radius: 4px;
    padding: 8px;
}</string>
